APP_ENV=production
DATA_BACKEND=firebase
FIREBASE_DATABASE_URL=https://YOUR_DATABASE.asia-southeast1.firebasedatabase.app
FIREBASE_WEB_API_KEY=
# Server-only JSON, stored as a Sensitive production variable in Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative existing legacy RTDB server credential; keep server-only/Sensitive.
FIREBASE_DATABASE_SECRET=
FIREBASE_DATA_NAMESPACE=stkgears

# Optional local MySQL backend: set DATA_BACKEND=mysql.
DB_HOST=
DB_PORT=3306
DB_NAME=stkgear
DB_USER=
DB_PASS=
# Paste the cloud provider's CA certificate here (multiline value in Vercel),
# or set DB_SSL_CA to the absolute path of a local CA file for CLI imports.
DB_SSL_CA_PEM=
DB_SSL_CA=
SESSION_LIFETIME=7200
