FROM dunglas/frankenphp:1-php8.4-alpine

WORKDIR /app

RUN install-php-extensions pdo_mysql mbstring curl \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && printf 'expose_php=Off\nsession.cookie_httponly=1\nsession.cookie_samesite=Lax\nsession.use_strict_mode=1\nsession.save_path=/tmp\n' > "$PHP_INI_DIR/conf.d/stkgears.ini"

COPY Caddyfile /etc/caddy/Caddyfile
COPY index.php ./index.php
COPY api ./api
COPY config ./config
COPY core ./core
COPY pages ./pages
COPY services ./services
COPY public ./public
COPY assets ./public/assets

ENV APP_ENV=production
ENV PORT=80

EXPOSE 80

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
